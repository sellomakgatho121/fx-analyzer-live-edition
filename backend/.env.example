# ── FX Analyzer Pro — Backend environment ─────────────────────────────
# Copy to .env and adjust. Never commit .env.

# REST/WebSocket server port
PORT=4000

# API key required by protected REST routes (x-api-key header)
API_KEY=fx-analyzer-secure-key-2026

# JWT signing secret (Phase 2). REQUIRED in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A dev fallback exists if unset; never commit a real secret.
JWT_SECRET=

# ── Python engine transport ────────────────────────────────────────────
# ZeroMQ pub/command ports. These match the LIVE engine on this device
# (ZMQ PUB 5565 / REP CMD 5566). The engine code defaults are 5555/5556
# (engine/bridge.py); both are overridable via env.
ZMQ_PORT=5565
ZMQ_CMD_PORT=5566

# HTTP/SSE fallback transport (engine/http_bridge.py). Used automatically
# when the zeromq native addon cannot be loaded.
ENGINE_HTTP_URL=http://127.0.0.1:8765
