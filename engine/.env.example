# --- LLM Provider ---
# OpenCode Zen is the ONLY provider (OpenAI-compatible, https://opencode.ai/zen/v1)
OPENCODE_API_KEY=zen-your_opencode_key_here

# --- Broker ---
# 'ctrader' (default) = live/demo via the cTrader Open API — the ONLY source
# of live data. 'mock' = dry-run/development only, never feeds live data.
BROKER_PROVIDER=ctrader
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
