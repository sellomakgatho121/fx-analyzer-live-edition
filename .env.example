# Gemini API Key (required for AI analysis)
GEMINI_API_KEY=your-gemini-api-key-here

# Backend URL (default for local dev)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# JWT Secret (for auth tokens)
JWT_SECRET=your-jwt-secret-here

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Broker — live data and execution come ONLY from the cTrader Open API.
# Default provider is 'ctrader' (live/demo). 'mock' is dry-run/development
# only and never feeds live data to the UI.
BROKER_PROVIDER=ctrader
CTRADER_CLIENT_ID=your-ctrader-client-id
CTRADER_CLIENT_SECRET=your-ctrader-client-secret
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_DEMO=1
